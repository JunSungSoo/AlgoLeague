{
    "name": "algoleague",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "node scripts/check-code-conventions.mjs && eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "vitest run --passWithNoTests --dir src",
        "test:watch": "vitest"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "yarn@1.22.22",
    "dependencies": {
        "@chakra-ui/react": "^3.36.1",
        "@emotion/react": "^11.14.0",
        "dayjs": "^1.11.21",
        "jose": "^6.2.8",
        "lucide-react": "^1.31.0",
        "next": "^16.3.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9",
        "eslint-config-next": "^16.3.0",
        "prettier": "^3.9.6",
        "typescript": "^6",
        "vitest": "^4.1.10"
    }
}
